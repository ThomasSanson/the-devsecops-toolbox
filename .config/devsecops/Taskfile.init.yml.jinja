{%- raw %}
---
version: "3"

tasks:
  default:
    desc: 🚀 Initialize DevSecOps project
    summary: |
      ℹ️ Description:
        Full project initialization: verifies prerequisites, installs
        dev tools, and configures GitLab project settings.

      🔄 Execution:
        1. unzip check (fail fast if missing)
        2. dev:setup-environment (install all tools)
        3. configure (GitLab project settings)
    cmds:
      - cmd: echo "🚀 Starting DevSecOps project initialization"
        silent: true
      - task: :unzip:check:installed
      - cmd: echo "📦 Checking prerequisites..."
        silent: true
      - task: :dev:setup-environment
{%- endraw %}
{%- if ci_platform.startswith('gitlab') %}
{% raw %}      - task: configure
{%- endraw %}
{%- endif %}
{% raw %}      - cmd: echo "✅ DevSecOps project initialization completed"
        silent: true

  prerequisites:
    desc: 📦 Install missing prerequisites and rerun init
    summary: |
      ℹ️ Description:
        Installs the currently required prerequisites and reruns
        task devsecops:init automatically.

      🔄 Execution:
        1. Installs unzip with sudo
        2. Reruns task devsecops:init
    cmds:
      - cmd: echo "📦 Installing missing prerequisites..."
        silent: true
      - task: :unzip:install:sudo
      - cmd: |
          TASK_BIN="$(command -v task)"
          echo "🔄 Re-running task devsecops:init..."
          sudo env \
            PATH="$PATH" \
            GITLAB_HOST="${GITLAB_HOST:-}" \
            GITLAB_TOKEN="${GITLAB_TOKEN:-}" \
            GLAB_TEST_TOKEN="${GLAB_TEST_TOKEN:-}" \
            "$TASK_BIN" devsecops:init
        silent: false

  template:
    interactive: true
    desc: � Scaffold or update project from template
    summary: |
      ℹ️ Description:
        Runs Copier to scaffold a new project or update an existing one
        from the DevSecOps Toolbox template.

      🔄 Execution:
        Delegates to the copier task with the template URL.

      📝 Usage:
        task devsecops:init:template                          # scaffold
        task devsecops:init:template -- --defaults            # scaffold with defaults
        task devsecops:init:template TASK_COPIER_ANSWER_FILE=.config/devsecops/.copier-answers.yml  # update
    cmds:
      - cmd: echo "📋 Running Copier template..."
        silent: true
      - task: :copier
      - cmd: echo "✅ Template applied"
        silent: true
{%- endraw %}
{%- if ci_platform.startswith('gitlab') %}
{% raw %}
  configure:
    desc: ⚙️ Configure GitLab project settings
    status:
      - test "{{.TASK_GLAB_ENABLED}}" = "false"
    summary: |
      ℹ️ Description:
        Configures the GitLab project:
        1. Installs glab CLI
        2. Configures merge request settings
        3. Sets up project access tokens (Renovate, Commitizen)
        4. Configures protected branches
    deps:
      - :glab:install
    cmds:
      - cmd: echo "⚙️ Configuring GitLab project..."
        silent: true
      - task: :glab:merge-settings
      - task: :glab:renovate-token
      - task: :glab:commitizen-token
      - task: :glab:protected-branch
      - cmd: echo "✅ GitLab project configured"
        silent: true
{%- endraw %}
{%- endif %}
