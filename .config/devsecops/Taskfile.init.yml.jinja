{%- raw %}
---
version: "3"

tasks:
  default:
    desc: 🚀 Initialize DevSecOps project (local setup)
    summary: |
      ℹ️ Description:
        Full local initialization: installs dev tools and configures GitLab
        project settings (merge method).

      🔄 Execution:
        1. dev:setup-environment (install all tools)
        2. setup-gitlab (configure merge method)
    cmds:
      - cmd: echo "🚀 Starting DevSecOps project initialization"
        silent: true
      - task: :dev:setup-environment
{%- endraw %}
{%- if ci_platform.startswith('gitlab') %}
{% raw %}      - task: setup-gitlab
{%- endraw %}
{%- endif %}
{% raw %}      - cmd: echo "✅ DevSecOps project initialization completed"
        silent: true
{%- endraw %}
{%- if ci_platform.startswith('gitlab') %}
{% raw %}
  setup-gitlab:
    desc: 🦊 Configure GitLab project settings
    status:
      - test "{{.TASK_GLAB_ENABLED}}" = "false"
    summary: |
      ℹ️ Description:
        Configures the GitLab project:
        1. Configures the merge method to fast-forward
    deps:
      - :glab:install
    cmds:
      - cmd: echo "🦊 Configuring GitLab project..."
        silent: true
      - task: :glab:merge-method
      - cmd: echo "✅ GitLab project configured"
        silent: true
{%- endraw %}
{%- endif %}
