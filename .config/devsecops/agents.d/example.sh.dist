# One AI tool the test-first cycle can drive. Copy this file to <tool>.sh in the
# same directory and fill in the two values — only *.sh files are picked up, so
# this template is never used by mistake. See README.md for the full contract.

# Reads the prompt on STANDARD INPUT, edits the working tree, commits nothing.
# Its first word is the binary looked for on this machine. {{MODEL}} is replaced
# by TASK_AGENT_MODEL when the phase runs.
AGENT_EXEC_CMD="my-tool run --model {{MODEL}}"

# Optional: how this tool lists its OWN models. The framework holds no model
# name of its own — it asks the tool, so nothing here can go stale.
AGENT_MODELS_CMD="my-tool models list"
