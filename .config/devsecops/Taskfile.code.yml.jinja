{% raw -%}
---
version: "3"

vars:
  TASK_DEVSECOPS_CODE_ENABLED: '{{.TASK_DEVSECOPS_CODE_ENABLED | default "true"}}'

tasks:
  default:
    desc: Run all generic code tasks
    status:
      - test "{{.TASK_DEVSECOPS_CODE_ENABLED}}" = "false"
    cmds:
      - cmd: echo "🔄 Starting code phase"
        silent: true
{%- endraw %}
{%- if project_enabled %}
{% raw %}      - task: :project:code
{%- endraw %}
{%- endif %}
{% raw %}
      - task: :betterleaks:scan-branch
      - task: :commitlint
      - task: :commitizen:check
      - task: :commitizen:bump
        vars:
          TASK_COMMITIZEN_BUMP_YES: "true"
          TASK_COMMITIZEN_BUMP_DRY_RUN: "true"
      - task: :lizard
      - task: :renovate:validate
      - task: :megalinter:npx
      - cmd: echo "🎉 Code phase completed successfully"
        silent: true
{%- endraw %}
{% raw %}
  verify:
    desc: |
      ℹ️ Description:
        The code phase, and the one cheat that belongs to it. Answers with a
        single exit code: the linter passed, AND this change silenced none of
        it — no `eslint-disable`, `# noqa`, `# nosec` or `shellcheck disable`
        added to make an error go away.

        A linter error is a thing to correct, not a thing to mute. That is the
        one sentence a linter cannot enforce about itself, so it is enforced
        here.

      🚀 Usage: task devsecops:code:verify
    cmds:
      - task: :devsecops:test:check:no-cheat
        vars: { BASE: HEAD, ONLY: linter }
      - task: default

  sync-templates:
    desc: "Syncs the project templates using the specific answers file."
    cmds:
      - task: :copier:update
        vars:
          TASK_COPIER_ANSWER_FILE: ".config/devsecops/.copier-answers.yml"
          # The caller may need more than --skip-answered: Renovate adds
          # --vcs-ref to move to a precise release. Hardcoding the options here
          # silently dropped it, and the update ran against the wrong target.
          TASK_COPIER_CLI_OPTS: '{{.TASK_COPIER_CLI_OPTS | default "--skip-answered"}}'

  sync-templates:renovate:
    desc: "Renovate only: discards every uncommitted change, then syncs the project templates."
    summary: |
      ℹ️ Description:
        What Renovate's post-upgrade command calls on a toolbox release. Renovate's
        own Copier run works from the folder of the answers file: it bumps the
        version line, leaves a stray VERSION in .config/devsecops/ and regenerates
        nothing. This throws all of that away, then runs sync-templates from the
        project root.

        Renovate runs post-upgrade commands without a shell, so this has to be one
        command it can call: a line chained with && hands "&&" to git as a path.

        It discards uncommitted work: on your own copy, run sync-templates instead.
    cmds:
      - git checkout -- .
      - git clean -fd
      - task: sync-templates
{%- endraw %}
