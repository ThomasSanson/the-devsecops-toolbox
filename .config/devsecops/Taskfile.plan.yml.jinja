{% raw -%}
---
version: "3"

vars:
  TASK_DEVSECOPS_PLAN_ENABLED: '{{.TASK_DEVSECOPS_PLAN_ENABLED | default "true"}}'

tasks:
  default:
    desc: 📋 Run all generic plan tasks
    summary: |
      Orchestrates the planning phase.
      This task runs all project-specific planning tasks defined in project/Taskfile.yml.
    status:
      - test "{{.TASK_DEVSECOPS_PLAN_ENABLED}}" = "false"
    cmds:
      - cmd: echo "🔄 Starting plan phase"
        silent: true
{%- endraw %}
{%- if project_enabled %}
{% raw %}      - task: :project:plan
{%- endraw %}
{%- endif %}
{% raw %}      - cmd: echo "🎉 Plan phase completed successfully"
        silent: true
{%- endraw %}
