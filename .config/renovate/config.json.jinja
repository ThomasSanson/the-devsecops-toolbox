{#-
  This is the DOWNSTREAM (generated-project) Renovate config, deliberately
  LIGHTER than the framework repo's own .config/renovate/config.json.

  This repo is a Copier TEMPLATE and the single source of truth for everything
  under .config/: it (and only it) bumps task, copier, gum, glow, ... So a
  generated project must NOT re-track those — it only watches the framework
  evolution (.copier-answers.yml -> `task copier:update`) plus its own project/**
  dependencies. Adding per-tool customManagers / .config/<tool> includePaths here
  would make every generated project open duplicate per-tool MRs (snowball).
  Proven by features/template/renovate.feature (@e2e-template-renovate-downstream).

  Copier refuses this template without --trust (it declares tasks). Renovate
  only passes --trust when the RUN allows scripts (allowScripts, a self-hosted
  option: `task renovate` exports it) AND the project opts in below with
  "ignoreScripts": false. allowedCommands is self-hosted too, so it lives in
  `task renovate`, never here, where Renovate would silently ignore it.

  Every update uses only its root-level task. The native Copier manager runs
  inside the answers directory: it caches stray generated files (a nested
  VERSION) even after the post-upgrade cleanup removes them, and its migrations
  fail there, which marks the merge request red. skipArtifactsUpdate avoids that
  first run; the post-upgrade task still applies the release and its recorded
  scope, from the project root.

  Deployment manifests are switched off by a package rule, not ignorePaths:
  Renovate does not merge ignorePaths, so setting it here would drop the
  node_modules/vendor/tests paths of config:recommended, and a project
  renovate.json that extends config:recommended would wipe it. Package rules
  add up. Proven by the same feature (@renovate-flow, issue #234).

  The minor and patch updates of project/** share one merge request; a major,
  the toolbox update (not under project/) and a vulnerability fix (Renovate
  forces its groupName to null) each keep their own. Measured on a generated
  project: ten merge requests cost ten full pipelines per merge on main.
  Proven by the same feature (@renovate-flow).
-#}
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(fix)"
  ],
  "onboarding": false,
  "requireConfig": "optional",
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps",
  "dependencyDashboard": true,
  "includePaths": [".config/devsecops/.copier-answers.yml", "project/**"],
  "packageRules": [
    {
      "description": "DevSecOps Toolbox: {% if install_scope == 'publication' %}update the publication component{% else %}update .copier-answers.yml and run task devsecops:code:sync-templates to regenerate all files{% endif %}",
      "matchManagers": ["copier"],
      "matchFileNames": [".config/devsecops/.copier-answers.yml"],
      "ignoreScripts": false,
      "skipArtifactsUpdate": true,
      "semanticCommitType": "{{ 'feat' if devsecops_update_release else 'chore' }}",
      "semanticCommitScope": "devsecops",
      "commitMessageTopic": "DevSecOps Toolbox",
      "postUpgradeTasks": {
        "commands": [
{%- if install_scope == 'publication' %}
          "sh .config/copier/renovate-update.sh {% raw %}{{{newVersion}}}{% endraw %}"
{%- else %}
          "task devsecops:code:sync-templates:renovate TASK_COPIER_CLI_OPTS='--skip-answered --defaults --vcs-ref {% raw %}{{{newVersion}}}{% endraw %}'"
{%- endif %}
        ],
        "fileFilters": ["**/*"],
        "executionMode": "branch"
      }{% if devsecops_automerge %},
      "automerge": true,
      "platformAutomerge": true,
      "automergeType": "pr",
      "automergeStrategy": "fast-forward"{% endif %}
    },
    {
      "description": "Auto-detect dependencies in project/",
      "matchFileNames": ["project/**"],
      "automerge": true,
      "platformAutomerge": true,
      "automergeType": "pr",
      "automergeStrategy": "fast-forward",
      "prCreation": "immediate"
    },
    {
      "description": "One merge request for every minor and patch update of project/: the main branch takes fast-forward merges only, so each merge made Renovate rebase every other open merge request and rerun its whole pipeline. Majors still come one by one.",
      "matchFileNames": ["project/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "project dependencies"
    },
    {
      "description": "Deployment manifests: an image tag there says what is deployed, not a dependency to keep up. A fix commit that bumped the project's own image made a release, whose new image Renovate bumped again, in a loop. A version reaches an environment through a merge request someone opens.",
      "matchFileNames": ["project/kustomize/**", "project/*/kustomize/**", "project/argocd/**"],
      "enabled": false
    }
  ]
}
