{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(fix)"
  ],
  "onboarding": false,
  "requireConfig": "optional",
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps",
  "dependencyDashboard": true,
  "includePaths": [".config/devsecops/.copier-answers.yml", "project/**", ".config/node/version"{% if ci_platform.startswith('gitlab') %}, ".config/glab/version", ".config/jq/version", ".config/task/version"{% endif %}],
  "allowedCommands": [
    "^git checkout -- \\. && git clean -fd && task copier:update TASK_COPIER_CLI_OPTS='--trust --skip-answered --defaults --vcs-ref .+'$"
  ],
  "packageRules": [
    {
      "description": "DevSecOps Toolbox: update .copier-answers.yml and run task copier:update to regenerate all files",
      "matchManagers": ["copier"],
      "matchFileNames": [".config/devsecops/.copier-answers.yml"],
      "semanticCommitType": "feat",
      "semanticCommitScope": "devsecops",
      "commitMessageTopic": "DevSecOps Toolbox",
      "postUpgradeTasks": {
        "commands": [
          "git checkout -- . && git clean -fd && task copier:update TASK_COPIER_CLI_OPTS='--trust --skip-answered --defaults --vcs-ref {% raw %}{{{newVersion}}}{% endraw %}'"
        ],
        "fileFilters": ["**/*"],
        "executionMode": "branch"
      }{% if devsecops_automerge %},
      "automerge": true,
      "platformAutomerge": true,
      "automergeType": "pr",
      "automergeStrategy": "fast-forward"{% endif %}
    },
    {
      "description": "Auto-detect dependencies in project/",
      "matchFileNames": ["project/**"],
      "automerge": true,
      "platformAutomerge": true,
      "automergeType": "pr",
      "automergeStrategy": "fast-forward",
      "prCreation": "immediate"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["\\.config/node/version$"],
      "matchStrings": ["(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    }{% if ci_platform.startswith('gitlab') %},
    {
      "customType": "regex",
      "fileMatch": ["\\.config/glab/version$"],
      "matchStrings": ["(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "gitlab-org/cli",
      "datasourceTemplate": "gitlab-releases",
      "registryUrlTemplate": "https://gitlab.com",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["\\.config/jq/version$"],
      "matchStrings": ["(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "jqlang/jq",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^jq-(?<version>.*)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["\\.config/task/version$"],
      "matchStrings": ["(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "go-task/task",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }{% endif %}
  ]
}
