{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(fix)"
  ],
  "onboarding": false,
  "requireConfig": "optional",
  "automerge": true,
  "platformAutomerge": true,
  "automergeType": "pr",
  "automergeStrategy": "fast-forward",
  "prCreation": "immediate",
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps",
  "commitBody": "Storyboard-exempt: dependency bump, proven by the whole suite re-running against the new versions rather than by a new card.",
  "dependencyDashboard": true,
  "packageRules": [
    {
      "description": "Version managed by commitizen, not Renovate",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "registry.gitlab.com/digital-commons/devsecops/the-devsecops-toolbox"
      ],
      "enabled": false
    },
    {
      "description": "MegaLinter's number is a DOCKER tag, not an npm version. The pipeline runs oxsecurity/megalinter:v<that number>, and the npm runner is published ahead of the image (npm 9.6.0 while the newest image is v9.4.0), so following npm proposes a version no registry can pull: 'manifest unknown', every job dead. The npm datasource is switched off here and the custom manager below follows the image instead \u2014 the artefact that actually has to exist.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["mega-linter-runner"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["\\.config/node/version$"],
      "matchStrings": ["(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    },
    {
      "customType": "regex",
      "fileMatch": ["\\.config/glab/version$"],
      "matchStrings": ["(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "gitlab-org/cli",
      "datasourceTemplate": "gitlab-releases",
      "registryUrlTemplate": "https://gitlab.com",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["\\.config/jq/version$"],
      "matchStrings": ["(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "jqlang/jq",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^jq-(?<version>.*)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["\\.config/task/version$"],
      "matchStrings": ["(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "go-task/task",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["\\.config/gum/version$"],
      "matchStrings": ["(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "charmbracelet/gum",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["\\.config/glow/version$"],
      "matchStrings": ["(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "charmbracelet/glow",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["\\.config/devsecops/install\\.sh$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s+\\w+_VERSION=\"(?:copier==)?(?<currentValue>[0-9][0-9.]*)\""
      ]
    },
    {
      "customType": "regex",
      "fileMatch": ["project/tests/e2e/support/steps/generated-ci\\.js$"],
      "matchStrings": [
        "// renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+const RUNNER_IMAGE = '[^:]+:(?<currentValue>[^']+)'"
      ]
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.config/megalinter/package\\.json$"],
      "matchStrings": [
        "\"mega-linter-runner\": \"(?<currentValue>[0-9][^\"]*)\""
      ],
      "depNameTemplate": "oxsecurity/megalinter",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
