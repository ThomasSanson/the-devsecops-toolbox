{% raw -%}
---
### DO NOT EDIT THIS FILE ###
# This file is managed by the project template.
# Any changes will be overwritten during the next update.
# To customize Megalinter, edit .config/megalinter/config.yml instead.
### DO NOT EDIT THIS FILE ###

# Configuration Inheritance Strategy
# ----------------------------------
# We use CONFIG_PROPERTIES_TO_APPEND to ensure that list-based configurations
# (like arguments) are merged rather than overwritten when extended.
CONFIG_PROPERTIES_TO_APPEND:
  - REPOSITORY_KINGFISHER_ARGUMENTS

APPLY_FIXES:
  - JSON_PRETTIER
  - YAML_PRETTIER
  - MARKDOWN_MARKDOWNLINT
  - MARKDOWN_MARKDOWN_TABLE_FORMATTER

DISABLE_LINTERS:
  # MegaLinter deprecated gitleaks in 9.6 in favour of betterleaks — same author,
  # same rules, same config format — and this framework followed it everywhere:
  # the standalone scan (`task betterleaks:scan-branch`, the `code:betterleaks`
  # job) and the pre-commit hook run betterleaks too. One scanner, one verdict,
  # one allowlist.
  - REPOSITORY_GITLEAKS
  - JSON_V8R
  - YAML_V8R
  - COPYPASTE_JSCPD
  - ANSIBLE_ANSIBLE_LINT

# IMPORTANT: EXCLUDED_DIRECTORIES does NOT work for linters in "project" mode
# Use FILTER_REGEX_EXCLUDE for linters in file/list_of_files mode
# And configure individual linters in project mode separately
EXCLUDED_DIRECTORIES:
  - .ansible
  - .cache
  - .claude
  - .config/podman/roles
  - .diagnostics
  - .git
  - _output
  - .ruff_cache
  - megalinter-reports
  - node_modules
  - tmp
  - vendor
  - venv

ANSIBLE_ANSIBLE_LINT_CONFIG_FILE: .config/ansible-lint/config.yaml
COPYPASTE_JSCPD_CONFIG_FILE: .config/jscpd/config.json
GHERKIN_GHERKIN_LINT_CONFIG_FILE: .config/gherkin-lint/config.json
REPOSITORY_DEVSKIM_CONFIG_FILE: .config/devskim/config.json
# betterleaks reads betterleaks' config format, so it inherits the allowlist the
# project already curated — the file keeps its name as long as the betterleaks
# binary uses it too.
REPOSITORY_BETTERLEAKS_CONFIG_FILE: .config/betterleaks/config.toml
# osv-scanner reads a lock file as it is, but for a bare requirements.txt it
# RESOLVES a dependency tree of its own and reports vulnerabilities in it. The
# pinned CLIs here (copier, lizard, commitizen, yamllint) are one line each and
# are installed by uv, which resolves at run time — so that invented tree
# reported CVEs on a pygments nobody installs. Scan what the project really
# pins; the lock files are still read in full.
REPOSITORY_OSV_SCANNER_ARGUMENTS:
  - "--no-resolve"
  # The toolbox scans these tools upstream. Projects receive fixes through
  # Copier updates; their own dependencies, including other .config tools,
  # remain in the scan. Keep these paths aligned with shipped dependencies.
  - "--experimental-exclude=.config/ansible"
  - "--experimental-exclude=.config/codeceptjs"
  - "--experimental-exclude=.config/commitizen"
  - "--experimental-exclude=.config/commitlint"
  - "--experimental-exclude=.config/copier"
  - "--experimental-exclude=.config/lizard"
  - "--experimental-exclude=.config/megalinter"
  - "--experimental-exclude=.config/yamllint"
REPOSITORY_GRYPE_CONFIG_FILE: .config/grype/config.yml
REPOSITORY_KICS_CONFIG_FILE: .config/kics/config.yml
REPOSITORY_KINGFISHER_ARGUMENTS:
  - "--exclude=.ansible"
  - "--exclude=.cache"
  - "--exclude=.claude"
  - "--exclude=.config/podman/roles"
  - "--exclude=.git"
  - "--exclude=_output"
  - "--exclude=megalinter-reports"
  - "--exclude=node_modules"
  - "--exclude=tmp"
  - "--exclude=vendor"
  - "--exclude=venv"
REPOSITORY_TRIVY_CONFIG_FILE: .config/trivy/config.yml
SPELL_CSPELL_CONFIG_FILE: .config/cspell/config.json
SPELL_LYCHEE_CONFIG_FILE: .config/lychee/config.toml
SPELL_LYCHEE_FILTER_REGEX_EXCLUDE: '(^|/)package-lock\.json$'
YAML_YAMLLINT_CONFIG_FILE: .config/yamllint/config.yml
{%- endraw %}
{%- if project_enabled %}
REPOSITORY_DUSTILOCK_ARGUMENTS:
  - "-p"
  - "project"
{%- else %}
REPOSITORY_DUSTILOCK_ARGUMENTS:
  - "-p"
  - "."
{%- endif %}
{% raw %}

SHOW_ELAPSED_TIME: true
SARIF_REPORTER: true
CLEAR_REPORT_FOLDER: true
PARALLEL_PROCESS_NUMBER: 2 # Limiting to 2 cores is necessary to prevent Dustilock or Checkov from crashing.

PRE_COMMANDS:
  # - command: cd /tmp/lint && mkdir -p /usr/share/ansible && find . -type f \( -iname 'requirements.yml' -o -iname 'requirements.yaml' \) -print0 | xargs -0 -I{} sh -c 'grep -Eq "^[[:space:]]*collections[[:space:]]*:" "{}" && ansible-galaxy collection install -r "{}" -p /usr/share/ansible/collections || ansible-galaxy role install -r "{}" --roles-path /usr/share/ansible/roles'
  - command: |
      npm install -g \
        @cspell/dict-companies \
        @cspell/dict-en-gb \
        @cspell/dict-fr-fr \
        @cspell/dict-python \
        @cspell/dict-software-terms

POST_COMMANDS:
  - command: test ! -d /tmp/lint/.ansible || chmod -R 777 /tmp/lint/.ansible
  - command: test ! -d /tmp/lint/.ansible || chown -R 1000:1000 /tmp/lint/.ansible
  - command: test ! -d /tmp/lint/.cache || chmod -R 777 /tmp/lint/.cache
  - command: test ! -d /tmp/lint/.cache || chown -R 1000:1000 /tmp/lint/.cache
  - command: test ! -d /tmp/lint/.php-cs-fixer.cache || chown -R 1000:1000 /tmp/lint/.php-cs-fixer.cache
  - command: test ! -d /tmp/lint/.phplint.cache || chown -R 1000:1000 /tmp/lint/.phplint.cache
  - command: test ! -d /tmp/lint/megalinter-reports || chmod -R 777 /tmp/lint/megalinter-reports
  - command: test ! -d /tmp/lint/megalinter-reports || chown -R 1000:1000 /tmp/lint/megalinter-reports

# Ignore only import errors E0401
PYTHON_PYLINT_ARGUMENTS:
  - --disable=E0401
# Create a pyrightconfig.json file to ignore import errors
PYTHON_PYRIGHT_PRE_COMMANDS:
  - command: |
      echo '{
        "reportMissingImports": false,
        "reportMissingModuleSource": false
      }' > pyrightconfig.json
    continue_if_failed: false
{%- endraw %}
