---
version: "3"

tasks:
  project:plan:
    desc: 🚀 Run project-specific plan tasks
    summary: |
      Orchestrates the plan phase.
      This task is intended to run Terraform plan, database migrations check, etc.
    cmds:
      - cmd: echo "🚀 Starting project plan phase"
        silent: true
      - cmd: echo "✅ Project Plan phase completed successfully"
        silent: true

  project:code:
    desc: 🚀 Run project-specific code tasks
    summary: |
      Orchestrates the code phase.
      This task runs linters, formatters, and static analysis tools.
    cmds:
      - cmd: echo "🚀 Starting project code phase"
        silent: true
      - cmd: echo "✅ Project Code phase completed successfully"
        silent: true

  project:build:
    desc: 🚀 Run project-specific build tasks
    summary: |
      Orchestrates the build phase.
      This task builds Docker images, compiles binaries, or packages artifacts.
    cmds:
      - cmd: echo "🚀 Starting project build phase"
        silent: true
      - cmd: echo "✅ Project Build phase completed successfully"
        silent: true

  project:test:
    desc: 🚀 Run project-specific test tasks
    summary: |
      Orchestrates the test phase.
      This task runs unit tests, integration tests, and TDD workflows.
    cmds:
      - cmd: echo "🚀 Starting project test phase"
        silent: true
      - task: test:tdd
      - cmd: echo "✅ Project Test phase completed successfully"
        silent: true

  project:test:tdd:
    desc: 🚀 Run project-specific TDD test tasks
    summary: |
      Run tests in TDD mode.
      This task deploys necessary services and runs CodeceptJS tests.
    cmds:
      - cmd: echo "🚀 Starting project TDD test phase"
        silent: true
      - task: deploy
      - cmd: echo "✅ Project TDD test phase completed successfully"
        silent: true

  project:release:
    desc: 🚀 Run project-specific release tasks
    summary: |
      Orchestrates the release phase.
      This task tags images, packages releases, and updates versions.
    cmds:
      - cmd: echo "🚀 Starting project release phase"
        silent: true
      - cmd: echo "✅ Project Release phase completed successfully"
        silent: true

  project:deploy:
    desc: 🚀 Run project-specific deploy tasks
    summary: |
      Orchestrates the deploy phase.
      This task deploys the application to the target environment.
    deps: [build]
    cmds:
      - cmd: echo "🚀 Starting project deploy phase"
        silent: true
      - cmd: echo "✅ Project Deploy phase completed successfully"
        silent: true

  project:operate:
    desc: 🚀 Run project-specific operate tasks
    summary: |
      Orchestrates the operate phase.
      This task manages operational tasks like backups, scaling, etc.
    cmds:
      - cmd: echo "🚀 Starting project operate phase"
        silent: true
      - cmd: echo "✅ Project Operate phase completed successfully"
        silent: true

  project:monitor:
    desc: 🚀 Run project-specific monitor tasks
    summary: |
      Orchestrates the monitor phase.
      This task checks system health and metrics.
    cmds:
      - cmd: echo "🚀 Starting project monitor phase"
        silent: true
      - cmd: echo "✅ Project Monitor phase completed successfully"
        silent: true

  project:feedback:
    desc: 🚀 Run project-specific feedback tasks
    summary: |
      Orchestrates the feedback phase.
      This task gathers feedback metrics and reports.
    cmds:
      - cmd: echo "🚀 Starting project feedback phase"
        silent: true
      - cmd: echo "✅ Project Feedback phase completed successfully"
        silent: true
