# =============================================================================
# DevSecOps Toolbox: Development Configuration
# =============================================================================
#
# This file contains the development values. It is versioned and works as it
# is: local work needs no file to copy or create.
# It is loaded second by Taskfile's dotenv mechanism, after .env and before
# .env.dist, so a value set here wins over its default in .env.dist.
#
# ENVIRONMENT LAYERING (loaded by priority, first wins):
#   .env       → Production/staging overrides (gitignored, never versioned)
#   .env.dev   → Development defaults (versioned, safe for local dev)
#   .env.dist  → Base defaults (versioned, no secrets)
#
# Secrets that only work in development may go here. Real secrets go in .env,
# on the deployed environment only.
# In production: delete this file, create .env with real values.
#
# =============================================================================

# Example configuration for CodeceptJS tests
CODECEPTJS_BASE_URL=http://localhost:8080
TASK_CODECEPTJS_ENABLED=true
