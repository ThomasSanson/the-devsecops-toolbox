---
# =============================================================================
# Taskfile.yml - DevSecOps Pipeline Orchestration
# =============================================================================
# Generated by Copier from template
# Stack: {{ stack_primary }}{% if stack_additional %} + {{ stack_additional | join(', ') }}{% endif %}
# =============================================================================
version: "3"

dotenv: [".env.devsecops", ".env", ".env.dev", ".env.dist"]

vars:
  # Environment variables for task control
  TASK_FLAGS: '{% raw %}{{.TASK_FLAGS | default ""}}{% endraw %}'
  TASK_SEPARATOR: '{% raw %}{{.TASK_SEPARATOR | default (print (repeat 120 "-") "\n" (repeat 120 "-") "\n" (repeat 120 "-"))}}{% endraw %}'
  TASK_DEVSECOPS_ICON: '{% raw %}{{.TASK_DEVSECOPS_ICON | default "♾️"}}{% endraw %}'

# Includes: Specify necessary and additional components for development.
includes:
  # DevSecOps stages (always included)
{% if stages_plan_enabled %}
  devsecops:plan:
    taskfile: .config/devsecops/Taskfile.plan.yml
{% endif %}
{% if stages_code_enabled %}
  devsecops:code:
    taskfile: .config/devsecops/Taskfile.code.yml
{% endif %}
{% if stages_build_enabled %}
  devsecops:build:
    taskfile: .config/devsecops/Taskfile.build.yml
{% endif %}
{% if stages_test_enabled %}
  devsecops:test:
    taskfile: .config/devsecops/Taskfile.test.yml
{% endif %}
{% if stages_release_enabled %}
  devsecops:release:
    taskfile: .config/devsecops/Taskfile.release.yml
{% endif %}
{% if stages_deploy_enabled %}
  devsecops:deploy:
    taskfile: .config/devsecops/Taskfile.deploy.yml
{% endif %}
{% if stages_operate_enabled %}
  devsecops:operate:
    taskfile: .config/devsecops/Taskfile.operate.yml
{% endif %}
{% if stages_monitor_enabled %}
  devsecops:monitor:
    taskfile: .config/devsecops/Taskfile.monitor.yml
{% endif %}
{% if stages_feedback_enabled %}
  devsecops:feedback:
    taskfile: .config/devsecops/Taskfile.feedback.yml
{% endif %}
  project:
    taskfile: project/Taskfile.yml

  # Stack-specific tools
{% if stack_primary == 'ansible' or 'ansible' in stack_additional %}
  ansible:
    taskfile: .config/ansible/Taskfile.yml
    optional: true
  yamllint:
    taskfile: .config/yamllint/Taskfile.yml
    optional: true
{% endif %}
{% if code_lizard_enabled %}
  lizard:
    taskfile: .config/lizard/Taskfile.yml
    optional: true
{% endif %}
{% if stack_primary == 'nodejs' or 'nodejs' in stack_additional %}
  nodejs:
    taskfile: .config/nodejs/Taskfile.yml
    optional: true
  bun:
    taskfile: .config/bun/Taskfile.yml
    optional: true
{% endif %}
{% if stack_primary == 'golang' or 'golang' in stack_additional %}
  go:
    taskfile: .config/go/Taskfile.yml
    optional: true
{% endif %}

  # Universal dev tools
{% if code_commitizen_enabled %}
  commitizen:
    taskfile: .config/commitizen/Taskfile.yml
    optional: true
{% endif %}
{% if code_commitlint_enabled %}
  commitlint:
    taskfile: .config/commitlint/Taskfile.yml
    optional: true
{% endif %}
{% if code_gitleaks_enabled %}
  gitleaks:
    taskfile: .config/gitleaks/Taskfile.yml
    optional: true
{% endif %}
{% if code_megalinter_enabled %}
  megalinter:
    taskfile: .config/megalinter/Taskfile.yml
    optional: true
{% endif %}
{% if code_renovate_enabled %}
  renovate:
    taskfile: .config/renovate/Taskfile.yml
    optional: true
{% endif %}
  
  # Infrastructure tools (only if relevant)
{% if build_docker_enabled %}
  docker-ce:
    taskfile: .config/docker-ce/Taskfile.yml
    optional: true
{% endif %}
  
  # Utility tools
  copier:
    taskfile: .config/copier/Taskfile.yml
    optional: true
  dev:
    taskfile: .config/dev/Taskfile.yml
    optional: true
  git:
    taskfile: .config/git/Taskfile.yml
    optional: true
  lefthook:
    taskfile: .config/lefthook/Taskfile.yml
    optional: true

tasks:
  tdd:
    # Orchestrates Test Driven Development (TDD) workflows.
    aliases:
      - default
    cmds:
      - task: code
      - task: build
      - task: test:tdd

  devsecops:
    # Orchestrates DevSecOps workflows.
    cmds:
{% if stages_plan_enabled %}
      - task: plan
{% endif %}
{% if stages_code_enabled %}
      - task: code
{% endif %}
{% if stages_build_enabled %}
      - task: build
{% endif %}
{% if stages_test_enabled %}
      - task: test
{% endif %}
{% if stages_release_enabled %}
      - task: release
{% endif %}
{% if stages_deploy_enabled %}
      - task: deploy
{% endif %}
{% if stages_operate_enabled %}
      - task: operate
{% endif %}
{% if stages_monitor_enabled %}
      - task: monitor
{% endif %}
{% if stages_feedback_enabled %}
      - task: feedback
{% endif %}

{% if stages_plan_enabled %}
  plan:
    cmds:
      - cmd: echo "{% raw %}{{.TASK_DEVSECOPS_ICON}}{% endraw %} Plan"
        silent: true
      - task: devsecops:plan
      - cmd: echo "{% raw %}{{.TASK_SEPARATOR}}{% endraw %}"
        silent: true
{% endif %}

{% if stages_code_enabled %}
  code:
    cmds:
      - cmd: echo "{% raw %}{{.TASK_DEVSECOPS_ICON}}{% endraw %} Code"
        silent: true
      - task: devsecops:code
      - cmd: echo "{% raw %}{{.TASK_SEPARATOR}}{% endraw %}"
        silent: true
{% endif %}

{% if stages_build_enabled %}
  build:
    cmds:
      - cmd: echo "{% raw %}{{.TASK_DEVSECOPS_ICON}}{% endraw %} Build"
        silent: true
      - task: devsecops:build
      - cmd: echo "{% raw %}{{.TASK_SEPARATOR}}{% endraw %}"
        silent: true
{% endif %}

{% if stages_test_enabled %}
  test:
    cmds:
      - cmd: echo "{% raw %}{{.TASK_DEVSECOPS_ICON}}{% endraw %} Test"
        silent: true
      - task: devsecops:test
      - cmd: echo "{% raw %}{{.TASK_SEPARATOR}}{% endraw %}"
        silent: true

  test:tdd:
    cmds:
      - task: devsecops:test:tdd
{% endif %}

{% if stages_release_enabled %}
  release:
    cmds:
      - cmd: echo "{% raw %}{{.TASK_DEVSECOPS_ICON}}{% endraw %} Release"
        silent: true
      - task: devsecops:release
      - cmd: echo "{% raw %}{{.TASK_SEPARATOR}}{% endraw %}"
        silent: true
{% endif %}

{% if stages_deploy_enabled %}
  deploy:
    cmds:
      - cmd: echo "{% raw %}{{.TASK_DEVSECOPS_ICON}}{% endraw %} Deploy"
        silent: true
      - task: devsecops:deploy
      - cmd: echo "{% raw %}{{.TASK_SEPARATOR}}{% endraw %}"
        silent: true
{% endif %}

{% if stages_operate_enabled %}
  operate:
    cmds:
      - cmd: echo "{% raw %}{{.TASK_DEVSECOPS_ICON}}{% endraw %} Operate"
        silent: true
      - task: devsecops:operate
      - cmd: echo "{% raw %}{{.TASK_SEPARATOR}}{% endraw %}"
        silent: true
{% endif %}

{% if stages_monitor_enabled %}
  monitor:
    cmds:
      - cmd: echo "{% raw %}{{.TASK_DEVSECOPS_ICON}}{% endraw %} Monitor"
        silent: true
      - task: devsecops:monitor
      - cmd: echo "{% raw %}{{.TASK_SEPARATOR}}{% endraw %}"
        silent: true
{% endif %}

{% if stages_feedback_enabled %}
  feedback:
    cmds:
      - cmd: echo "{% raw %}{{.TASK_DEVSECOPS_ICON}}{% endraw %} Feedback"
        silent: true
      - task: devsecops:feedback
      - cmd: echo "{% raw %}{{.TASK_SEPARATOR}}{% endraw %}"
        silent: true
{% endif %}
