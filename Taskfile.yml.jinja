---
# Taskfile.yml: Central hub for development operations.
version: "3"

dotenv: [".env", ".env.dev", ".env.dist"]

vars:
  # Environment variables for task control
  TASK_FLAGS: '{{ "{{" }}.TASK_FLAGS | default ""{{ "}}" }}'
  TASK_SEPARATOR: '{{ "{{" }}.TASK_SEPARATOR | default (print (repeat 120 "-") "\n" (repeat 120 "-") "\n" (repeat 120 "-")){{ "}}" }}'
  TASK_DEVSECOPS_ICON: '{{ "{{" }}.TASK_DEVSECOPS_ICON | default "♾️"{{ "}}" }}'

# Includes: Specify necessary and additional components for development.
# - Essential includes are required for a successful Docker build.
# - Optional includes extras like tests and lint (not needed for Docker builds)
includes:
  # Essential includes (Required for Docker build and k3s)
{#- A project that installed a single component has no build, deploy or monitor
    phase to run. The phase orchestrators are the only REQUIRED includes, so
    leaving eight of the nine out is what keeps such a project down to the few
    commands it actually runs. #}
{%- if install_scope != 'publication' %}
  devsecops:plan:
    taskfile: .config/devsecops/Taskfile.plan.yml
  devsecops:code:
    taskfile: .config/devsecops/Taskfile.code.yml
  devsecops:build:
    taskfile: .config/devsecops/Taskfile.build.yml
  devsecops:test:
    taskfile: .config/devsecops/Taskfile.test.yml
  devsecops:release:
    taskfile: .config/devsecops/Taskfile.release.yml
  devsecops:deploy:
    taskfile: .config/devsecops/Taskfile.deploy.yml
  devsecops:operate:
    taskfile: .config/devsecops/Taskfile.operate.yml
  devsecops:monitor:
    taskfile: .config/devsecops/Taskfile.monitor.yml
{%- endif %}
{#- The feedback phase is the one orchestrator a single-component project keeps:
    it is what runs Renovate, and Renovate is what brings the next toolbox
    release in. Without it the component would still be updatable by hand, and
    updated by nobody. #}
  devsecops:feedback:
    taskfile: .config/devsecops/Taskfile.feedback.yml
  devsecops:init:
    taskfile: .config/devsecops/Taskfile.init.yml
    optional: true
{%- if project_enabled %}
  project:
    taskfile: project/Taskfile.yml
    flatten: true
{%- endif %}
  # Optional includes (For dev, testing, linting, etc.)
{%- if ansible_enabled %}
  ansible:
    taskfile: .config/ansible/Taskfile.yml
    optional: true
{%- endif %}
  codeceptjs:
    taskfile: .config/codeceptjs/Taskfile.yml
    optional: true
  commitizen:
    taskfile: .config/commitizen/Taskfile.yml
    optional: true
  commitlint:
    taskfile: .config/commitlint/Taskfile.yml
    optional: true
  copier:
    taskfile: .config/copier/Taskfile.yml
    optional: true
  dev:
    taskfile: .config/dev/Taskfile.yml
    optional: true
{%- if container_runtime == 'docker' %}
  docker-ce:
    taskfile: .config/docker-ce/Taskfile.yml
    optional: true
{%- endif %}
  git:
    taskfile: .config/git/Taskfile.yml
    optional: true
  betterleaks:
    taskfile: .config/betterleaks/Taskfile.yml
    optional: true
  glab:
    taskfile: .config/glab/Taskfile.yml
    optional: true
  glow:
    taskfile: .config/glow/Taskfile.yml
    optional: true
  go:
    taskfile: .config/go/Taskfile.yml
    optional: true
  gum:
    taskfile: .config/gum/Taskfile.yml
    optional: true
  unzip:
    taskfile: .config/unzip/Taskfile.yml
    optional: true
  helm:
    taskfile: .config/helm/Taskfile.yml
    optional: true
  k3d:
    taskfile: .config/k3d/Taskfile.yml
    optional: true
  kaniko:
    taskfile: .config/kaniko/Taskfile.yml
    optional: true
  kind:
    taskfile: .config/kind/Taskfile.yml
    optional: true
  kubectl:
    taskfile: .config/kubectl/Taskfile.yml
    optional: true
  kubeseal:
    taskfile: .config/kubeseal/Taskfile.yml
    optional: true
  lefthook:
    taskfile: .config/lefthook/Taskfile.yml
    optional: true
  lizard:
    taskfile: .config/lizard/Taskfile.yml
    optional: true
  megalinter:
    taskfile: .config/megalinter/Taskfile.yml
    optional: true
{%- if container_runtime == 'podman' %}
  podman:
    taskfile: .config/podman/Taskfile.yml
    optional: true
{%- endif %}
  publication:
    taskfile: .config/publication/Taskfile.yml
    optional: true
  renovate:
    taskfile: .config/renovate/Taskfile.yml
    optional: true
  sealed-secrets:
    taskfile: .config/sealed-secrets/Taskfile.yml
    optional: true
  yamllint:
    taskfile: .config/yamllint/Taskfile.yml
    optional: true

tasks:
  tdd:
    # Orchestrates Test Driven Development (TDD) workflows.
    aliases:
      - default
    cmds:
      - task: code
      - task: build
      - task: test:tdd

  devsecops:
    # Orchestrates DevSecOps workflows.
    cmds:
      - task: plan
      - task: code
      - task: build
      - task: test
      - task: release
      - task: deploy
      - task: operate
      - task: monitor
      - task: feedback

  devsecops:reload:
    # Put a project back to what its own answers describe: the framework files
    # re-applied at the release it already tracks, and the GitLab setup redone
    # from scratch — tokens replaced even when they still work, protected
    # branch purged and re-created. What init does on day one, for a project
    # that has been alive a while and drifted since.
    desc: ♻️ Re-apply the project's answers and redo the GitLab setup, tokens included
    preconditions:
      - sh: test -z "$(git status --porcelain)"
        msg: "❌ Uncommitted changes. Commit or stash them first — a reload overwrites framework files."
    cmds:
      - task: copier:recopy
        vars:
          TASK_COPIER_ANSWER_FILE: .config/devsecops/.copier-answers.yml
      - task: glab:auth:ensure
      - task: glab:merge-settings
      - task: glab:renovate-token
        vars: { TASK_GLAB_RENOVATE_TOKEN_FORCE: "true" }
      - task: glab:commitizen-token
        vars: { TASK_GLAB_COMMITIZEN_TOKEN_FORCE: "true" }
      - task: glab:protected-branch
      - cmd: echo "♻️ Framework reloaded"
        silent: true

  devsecops:update:
    # Move the project to the latest toolbox release, delivered as a merge
    # request instead of a push to the default branch — the manual equivalent
    # of the update merge request Renovate opens on its own.
    desc: 🔄 Apply the latest toolbox release, through a merge request
    preconditions:
      - sh: test -z "$(git status --porcelain)"
        msg: "❌ Uncommitted changes. Commit or stash them first — the update commits what it changes."
    cmds:
      - task: copier:update
        vars:
          TASK_COPIER_ANSWER_FILE: .config/devsecops/.copier-answers.yml
          TASK_COPIER_CLI_OPTS: --skip-answered --defaults
      - task: glab:update-merge-request

  plan:
    cmds:
      - cmd: echo "{{ "{{" }}.TASK_DEVSECOPS_ICON{{ "}}" }} Plan"
        silent: true
      - task: devsecops:plan
      - cmd: echo "{{ "{{" }}.TASK_SEPARATOR{{ "}}" }}"
        silent: true

  code:
    cmds:
      - cmd: echo "{{ "{{" }}.TASK_DEVSECOPS_ICON{{ "}}" }} Code"
        silent: true
      - task: devsecops:code
      - cmd: echo "{{ "{{" }}.TASK_SEPARATOR{{ "}}" }}"
        silent: true

  build:
    cmds:
      - cmd: echo "{{ "{{" }}.TASK_DEVSECOPS_ICON{{ "}}" }} Build"
        silent: true
      - task: devsecops:build
      - cmd: echo "{{ "{{" }}.TASK_SEPARATOR{{ "}}" }}"
        silent: true

  test:
    cmds:
      - cmd: echo "{{ "{{" }}.TASK_DEVSECOPS_ICON{{ "}}" }} Test"
        silent: true
      - task: devsecops:test
      - cmd: echo "{{ "{{" }}.TASK_SEPARATOR{{ "}}" }}"
        silent: true

  test:tdd:
    cmds:
      - cmd: echo "{{ "{{" }}.TASK_DEVSECOPS_ICON{{ "}}" }} Test Tdd"
        silent: true
      - task: devsecops:test:tdd
      - cmd: echo "{{ "{{" }}.TASK_SEPARATOR{{ "}}" }}"
        silent: true

  release:
    cmds:
      - cmd: echo "{{ "{{" }}.TASK_DEVSECOPS_ICON{{ "}}" }} Release"
        silent: true
      - task: devsecops:release
      - cmd: echo "{{ "{{" }}.TASK_SEPARATOR{{ "}}" }}"
        silent: true

  deploy:
    cmds:
      - cmd: echo "{{ "{{" }}.TASK_DEVSECOPS_ICON{{ "}}" }} Deploy"
        silent: true
      - task: devsecops:deploy
      - cmd: echo "{{ "{{" }}.TASK_SEPARATOR{{ "}}" }}"
        silent: true

  operate:
    cmds:
      - cmd: echo "{{ "{{" }}.TASK_DEVSECOPS_ICON{{ "}}" }} Operate"
        silent: true
      - task: devsecops:operate
      - cmd: echo "{{ "{{" }}.TASK_SEPARATOR{{ "}}" }}"
        silent: true

  monitor:
    cmds:
      - cmd: echo "{{ "{{" }}.TASK_DEVSECOPS_ICON{{ "}}" }} Monitor"
        silent: true
      - task: devsecops:monitor
      - cmd: echo "{{ "{{" }}.TASK_SEPARATOR{{ "}}" }}"
        silent: true

  feedback:
    cmds:
      - cmd: echo "{{ "{{" }}.TASK_DEVSECOPS_ICON{{ "}}" }} Feedback"
        silent: true
      - task: devsecops:feedback
      - cmd: echo "{{ "{{" }}.TASK_SEPARATOR{{ "}}" }}"
        silent: true
