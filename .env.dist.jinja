# =============================================================================
# DevSecOps Toolbox — Default Configuration
# =============================================================================
#
# This file contains default values for all configuration variables.
# It is loaded last (lowest priority) by Taskfile's dotenv mechanism.
#
# ENVIRONMENT LAYERING (loaded by priority, first wins):
#   .env       → Production/staging overrides (gitignored, never versioned)
#   .env.dev   → Development defaults (versioned, safe for local dev)
#   .env.dist  → Base defaults (versioned, no secrets)
#
# In production: delete .env.dev, create .env with real values.
# In development: .env.dev provides working defaults out of the box.
#
# TOOLBOX CONFIGURATION VARIABLES
# -------------------------------
# All toolbox-specific configuration variables should be prefixed with 'TASK_'
# and defined below. These variables control various aspects of the toolbox's
# behaviour and integration with external tools and services.
#
# =============================================================================
# Additional TASK_ variables should be added below this section
# =============================================================================
# TASK_XXX=value

{%- if source_publication %}
# Source publication — publish this repository's source to a public one.
# Off by default: a project that is already public does not need it. See
# .config/publication/README.md.
TASK_PUBLICATION_ENABLED=false
# The public repository to publish to, and the branch it publishes on.
TASK_PUBLICATION_TARGET_URL=
TASK_PUBLICATION_TARGET_BRANCH=main
# What gets published, and when. Empty means the repository's default branch;
# name a branch or a tag to publish that instead. release = after the tag on the
# default branch, tag = only on a tag pipeline, manual = only when somebody asks.
TASK_PUBLICATION_SOURCE_REF=
TASK_PUBLICATION_ON=release
# What becomes public is scanned for secrets first. "off" publishes without a
# scan; leave it alone unless you know why you are turning it off.
TASK_PUBLICATION_SCAN=required
# The token that may push there lives in the CI variables (masked, protected)
# or in .env — never in a versioned file.
{%- endif %}
{%- if not privileged_ci_runners %}

# Your runners cannot start privileged containers, so the secret scanner runs
# from the binary pinned in .config/betterleaks/version instead of an image.
# Set this back to "docker" if that ever changes.
TASK_BETTERLEAKS_MODE=binary
{%- endif %}
