# =============================================================================
# DevSecOps Toolbox Configuration Template
# =============================================================================
#
# This file serves as a template for environment configuration variables
# required by the DevSecOps Toolbox. Please copy this file to '.env' and
# configure the appropriate values for your environment.
#
# TOOLBOX CONFIGURATION VARIABLES
# -------------------------------
# All toolbox-specific configuration variables should be prefixed with 'TASK_'
# and defined below. These variables control various aspects of the toolbox's
# behaviour and integration with external tools and services.
#
# Please add your toolbox-specific TASK_ variables here
#
# =============================================================================
# Additional TASK_ variables should be added below this section
# =============================================================================
{%- if proxy_enabled %}
# Proxy Configuration
# -------------------
# Configure these if your environment requires proxy access
{%- if http_proxy %}
HTTP_PROXY={{ http_proxy }}
{%- endif %}
{%- if https_proxy %}
HTTPS_PROXY={{ https_proxy }}
{%- endif %}
{%- if no_proxy %}
NO_PROXY={{ no_proxy }}
{%- endif %}
{%- endif %}

# TASK_XXX=value
